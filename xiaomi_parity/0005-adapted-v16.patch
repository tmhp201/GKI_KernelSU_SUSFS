+config XIAOMI_ENHANCED_IOSTAT
+	bool "Xiaomi enhanced F2FS I/O latency statistics"
+	depends on F2FS_FS && F2FS_IOSTAT
+	default y
+	help
+	  Keep the stock dash sysfs ABI for window and daily I/O latency
+	  statistics.  Latency is collected from the normal F2FS bio completion
+	  path; no vendor binary is required.
+
+config F2FS_VIP_FILE
+	bool "Xiaomi F2FS VIP inode tracking"
+	depends on F2FS_FS
+	default y
+	help
+	  Provide the stock VIP inode manager and vip_file_enable sysfs node.
+	  The manager is intentionally dormant until a caller inserts a VIP inode.
+
+config F2FS_FS_HYBRID_UFS
+	bool "Xiaomi F2FS hybrid UFS allocation"
+	depends on F2FS_FS
+	select BLOCK_HYBRID_UFS
+	default y
+	help
+	  Provide the stock hybrid UFS configuration and sysfs ABI.  The AOSP
+	  block layer has no paired-LUN hybrid allocator, so this implementation
+	  reports the device as not capable and safely falls back to the normal
+	  single-device allocator.
