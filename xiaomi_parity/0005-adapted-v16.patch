diff --git a/fs/f2fs/xiaomi.c b/fs/f2fs/xiaomi.c
new file mode 100644
index 0000000..63942c3
--- /dev/null
+++ b/fs/f2fs/xiaomi.c
@@ -0,0 +1,415 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Xiaomi F2FS compatibility features.
+ *
+ * The stock dash kernel contains vendor-only I/O statistics, VIP inode tracking
+ * and a UFS hybrid allocator.  The vendor source is not public.  This file
+ * provides the observable interfaces and a conservative implementation:
+ * statistics are measured from the normal F2FS bio completion path, while the
+ * hybrid allocator intentionally reports "not capable" and never remaps writes.
+ */
+
+#include <linux/kernel.h>
+#include <linux/ktime.h>
+#include <linux/math64.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/sysfs.h>
+#include <linux/f2fs_fs.h>
+
+#include "f2fs.h"
+#include "xiaomi.h"
+
+void f2fs_xiaomi_init(struct f2fs_sb_info *sbi)
+{
+#ifdef CONFIG_F2FS_VIP_FILE
+	spin_lock_init(&sbi->vip.lock);
+	sbi->vip.enabled = false;
+#endif
+#ifdef CONFIG_F2FS_FS_HYBRID_UFS
+	f2fs_xiaomi_hybrid_init(sbi);
+#endif
+}
+
+void f2fs_xiaomi_destroy(struct f2fs_sb_info *sbi)
+{
+#ifdef CONFIG_F2FS_VIP_FILE
+	f2fs_vip_destroy(sbi);
+#endif
+}
+
+#ifdef CONFIG_XIAOMI_ENHANCED_IOSTAT
+static const char * const f2fs_xiaomi_io_names[F2FS_XIAOMI_IO_BUCKETS] = {
+	"read", "write_sync", "write_async", "meta", "other",
+};
+
+static void f2fs_xiaomi_clear_stats(struct f2fs_xiaomi_lat_stats *stats,
+				    unsigned int nr)
+{
+	memset(stats, 0, sizeof(*stats) * nr);
+}
+
+void f2fs_xiaomi_iostat_init(struct f2fs_sb_info *sbi)
+{
+	struct f2fs_xiaomi_iostat *iostat = &sbi->xiostat;
+
+	memset(iostat, 0, sizeof(*iostat));
+	spin_lock_init(&iostat->lock);
+	iostat->window_period_ns = 5ULL * NSEC_PER_SEC;
+	iostat->latency_threshold_ns = 100ULL * NSEC_PER_MSEC;
+}
+
+void f2fs_xiaomi_iostat_destroy(struct f2fs_sb_info *sbi)
+{
+	/* The structure is embedded in f2fs_sb_info; no allocation to free. */
+}
+
+void f2fs_xiaomi_iostat_reset(struct f2fs_sb_info *sbi)
+{
+	struct f2fs_xiaomi_iostat *iostat = &sbi->xiostat;
+	unsigned long flags;
+
+	spin_lock_irqsave(&iostat->lock, flags);
+	f2fs_xiaomi_clear_stats(iostat->window, F2FS_XIAOMI_IO_BUCKETS);
+	f2fs_xiaomi_clear_stats(iostat->last_window, F2FS_XIAOMI_IO_BUCKETS);
+	f2fs_xiaomi_clear_stats(iostat->daily, F2FS_XIAOMI_IO_BUCKETS);
+	f2fs_xiaomi_clear_stats(iostat->delayed, F2FS_XIAOMI_IO_BUCKETS);
+	iostat->window_start_ns = ktime_get_ns();
+	spin_unlock_irqrestore(&iostat->lock, flags);
+}
+
+bool f2fs_xiaomi_iostat_enabled(struct f2fs_sb_info *sbi)
+{
+	return READ_ONCE(sbi->xiostat.enabled);
+}
+
+int f2fs_xiaomi_iostat_set_enabled(struct f2fs_sb_info *sbi, bool enabled)
+{
+	if (enabled) {
+		f2fs_xiaomi_iostat_reset(sbi);
+		WRITE_ONCE(sbi->xiostat.enabled, true);
+	} else {
+		WRITE_ONCE(sbi->xiostat.enabled, false);
+		f2fs_xiaomi_iostat_reset(sbi);
+	}
+	return 0;
+}
+
+static void f2fs_xiaomi_roll_window(struct f2fs_xiaomi_iostat *iostat, u64 now)
+{
+	if (now - iostat->window_start_ns < iostat->window_period_ns)
+		return;
+
+	memcpy(iostat->last_window, iostat->window,
+	       sizeof(iostat->window));
+	f2fs_xiaomi_clear_stats(iostat->window, F2FS_XIAOMI_IO_BUCKETS);
+	iostat->window_start_ns = now;
+}
+
+void f2fs_xiaomi_iostat_record(struct f2fs_sb_info *sbi, unsigned int bucket,
+			       u64 latency_ns)
+{
+	struct f2fs_xiaomi_iostat *iostat = &sbi->xiostat;
+	struct f2fs_xiaomi_lat_stats *s;
+	unsigned long flags;
+	u64 now;
+
+	if (bucket >= F2FS_XIAOMI_IO_BUCKETS || !READ_ONCE(iostat->enabled))
+		return;
+
+	now = ktime_get_ns();
+	spin_lock_irqsave(&iostat->lock, flags);
+	f2fs_xiaomi_roll_window(iostat, now);
+
+	s = &iostat->window[bucket];
+	s->sum_ns += latency_ns;
+	s->count++;
+	if (latency_ns > s->peak_ns)
+		s->peak_ns = latency_ns;
+
+	s = &iostat->daily[bucket];
+	s->sum_ns += latency_ns;
+	s->count++;
+	if (latency_ns > s->peak_ns)
+		s->peak_ns = latency_ns;
+
+	if (latency_ns >= iostat->latency_threshold_ns) {
+		s = &iostat->delayed[bucket];
+		s->sum_ns += latency_ns;
+		s->count++;
+		if (latency_ns > s->peak_ns)
+			s->peak_ns = latency_ns;
+	}
+	spin_unlock_irqrestore(&iostat->lock, flags);
+}
+
+static ssize_t f2fs_xiaomi_show_stats(struct f2fs_sb_info *sbi, char *buf,
+				      const struct f2fs_xiaomi_lat_stats *stats,
+				      bool include_delay)
+{
+	struct f2fs_xiaomi_lat_stats copy[F2FS_XIAOMI_IO_BUCKETS];
+	struct f2fs_xiaomi_lat_stats delay[F2FS_XIAOMI_IO_BUCKETS];
+	unsigned long flags;
+	ssize_t off = 0;
+	int i;
+
+	spin_lock_irqsave(&sbi->xiostat.lock, flags);
+	memcpy(copy, stats, sizeof(copy));
+	if (include_delay)
+		memcpy(delay, sbi->xiostat.delayed, sizeof(delay));
+	spin_unlock_irqrestore(&sbi->xiostat.lock, flags);
+
+	off += sysfs_emit_at(buf, off, "%-12s %-10s %-12s %-12s %-12s\n",
+			     "type", "count", "avg_ms", "peak_ms", "total_ms");
+	for (i = 0; i < F2FS_XIAOMI_IO_BUCKETS; i++) {
+		u64 avg = copy[i].count ?
+			div64_u64(copy[i].sum_ns, copy[i].count) : 0;
+
+		off += sysfs_emit_at(buf, off,
+			"%-12s %-10u %-12llu %-12llu %-12llu\n",
+			f2fs_xiaomi_io_names[i], copy[i].count,
+			div64_u64(avg, NSEC_PER_MSEC),
+			div64_u64(copy[i].peak_ns, NSEC_PER_MSEC),
+			div64_u64(copy[i].sum_ns, NSEC_PER_MSEC));
+	}
+	if (include_delay) {
+		off += sysfs_emit_at(buf, off, "delayed(count>=threshold)\n");
+		for (i = 0; i < F2FS_XIAOMI_IO_BUCKETS; i++)
+			off += sysfs_emit_at(buf, off, "%-12s %u\n",
+					     f2fs_xiaomi_io_names[i],
+					     delay[i].count);
+	}
+	return off;
+}
+
+ssize_t f2fs_xiaomi_iostat_show_window(struct f2fs_sb_info *sbi, char *buf)
+{
+	return f2fs_xiaomi_show_stats(sbi, buf, sbi->xiostat.window, true);
+}
+
+ssize_t f2fs_xiaomi_iostat_show_daily(struct f2fs_sb_info *sbi, char *buf)
+{
+	return f2fs_xiaomi_show_stats(sbi, buf, sbi->xiostat.daily, false);
+}
+
+ssize_t f2fs_xiaomi_iostat_show_config(struct f2fs_sb_info *sbi, char *buf)
+{
+	struct f2fs_xiaomi_iostat *iostat = &sbi->xiostat;
+
+	return sysfs_emit(buf, "enabled=%u window_period_s=%llu "
+			 "latency_threshold_ms=%llu\n",
+			 READ_ONCE(iostat->enabled),
+			 div64_u64(READ_ONCE(iostat->window_period_ns),
+				   NSEC_PER_SEC),
+			 div64_u64(READ_ONCE(iostat->latency_threshold_ns),
+				   NSEC_PER_MSEC));
+}
+
+ssize_t f2fs_xiaomi_iostat_store_config(struct f2fs_sb_info *sbi,
+					const char *buf, size_t len)
+{
+	struct f2fs_xiaomi_iostat *iostat = &sbi->xiostat;
+	char *copy, *p, *token;
+	bool changed_period = false, changed_threshold = false;
+	bool changed_enabled = false;
+	unsigned int period_s, threshold_ms, enabled;
+	int ret = 0;
+
+	copy = kstrndup(buf, len, GFP_KERNEL);
+	if (!copy)
+		return -ENOMEM;
+
+	p = strim(copy);
+	while ((token = strsep(&p, " \t\n,")) != NULL) {
+		if (!*token)
+			continue;
+		if (sscanf(token, "window_period_s=%u", &period_s) == 1) {
+			if (!period_s || period_s > 86400) {
+				ret = -EINVAL;
+				goto out;
+			}
+			changed_period = true;
+		} else if (sscanf(token, "latency_threshold_ms=%u",
+				  &threshold_ms) == 1) {
+			if (threshold_ms > 3600000) {
+				ret = -EINVAL;
+				goto out;
+			}
+			changed_threshold = true;
+		} else if (sscanf(token, "enabled=%u", &enabled) == 1) {
+			if (enabled > 1) {
+				ret = -EINVAL;
+				goto out;
+			}
+			changed_enabled = true;
+		} else {
+			ret = -EINVAL;
+			goto out;
+		}
+	}
+
+	if (changed_period) {
+		WRITE_ONCE(iostat->window_period_ns,
+			   (u64)period_s * NSEC_PER_SEC);
+		iostat->window_start_ns = ktime_get_ns();
+	}
+	if (changed_threshold)
+		WRITE_ONCE(iostat->latency_threshold_ns,
+			   (u64)threshold_ms * NSEC_PER_MSEC);
+	if (changed_enabled)
+		f2fs_xiaomi_iostat_set_enabled(sbi, enabled);
+	/* A pure whitespace write is accepted as a no-op. */
+out:
+	kfree(copy);
+	return ret ? ret : len;
+}
+#endif /* CONFIG_XIAOMI_ENHANCED_IOSTAT */
+
+#ifdef CONFIG_F2FS_VIP_FILE
+/* Bound the fallback-selected VIP set; stock uses a larger manager. */
+#define F2FS_VIP_INODES_MAX	8192
+
+/* Return the sorted-array insertion index, or the matching index. */
+static int __f2fs_vip_lower_bound(struct f2fs_sb_info *sbi, u32 ino)
+{
+	u32 lo = 0, hi = sbi->vip.count;
+
+	while (lo < hi) {
+		u32 mid = lo + (hi - lo) / 2;
+
+		if (sbi->vip.inodes[mid] < ino)
+			lo = mid + 1;
+		else
+			hi = mid;
+	}
+	return lo;
+}
+
+int f2fs_vip_bsearch(struct f2fs_sb_info *sbi, u32 ino)
+{
+	unsigned long flags;
+	int index = -ENOENT;
+
+	spin_lock_irqsave(&sbi->vip.lock, flags);
+	if (sbi->vip.count) {
+		int pos = __f2fs_vip_lower_bound(sbi, ino);
+
+		if (pos < sbi->vip.count && sbi->vip.inodes[pos] == ino)
+			index = pos;
+	}
+	spin_unlock_irqrestore(&sbi->vip.lock, flags);
+	return index;
+}
+
+int f2fs_vip_insert(struct f2fs_sb_info *sbi, u32 ino)
+{
+	unsigned long flags;
+	u32 *inodes, *grown;
+	u32 new_capacity;
+	int pos;
+
+	if (!READ_ONCE(sbi->vip.enabled))
+		return 0;
+
+	spin_lock_irqsave(&sbi->vip.lock, flags);
+	pos = __f2fs_vip_lower_bound(sbi, ino);
+	if (pos < sbi->vip.count && sbi->vip.inodes[pos] == ino) {
+		spin_unlock_irqrestore(&sbi->vip.lock, flags);
+		return 0;
+	}
+	if (sbi->vip.count >= F2FS_VIP_INODES_MAX) {
+		spin_unlock_irqrestore(&sbi->vip.lock, flags);
+		return -ENOSPC;
+	}
+	if (sbi->vip.count == sbi->vip.capacity) {
+		new_capacity = sbi->vip.capacity ? sbi->vip.capacity * 2 : 64;
+		if (new_capacity < sbi->vip.capacity ||
+		    new_capacity > 1U << 20) {
+			spin_unlock_irqrestore(&sbi->vip.lock, flags);
+			return -ENOSPC;
+		}
+		inodes = kcalloc(new_capacity, sizeof(*inodes), GFP_ATOMIC);
+		if (!inodes) {
+			spin_unlock_irqrestore(&sbi->vip.lock, flags);
+			return -ENOMEM;
+		}
+		memcpy(inodes, sbi->vip.inodes,
+		       sbi->vip.count * sizeof(*inodes));
+		grown = sbi->vip.inodes;
+		sbi->vip.inodes = inodes;
+		sbi->vip.capacity = new_capacity;
+		kfree(grown);
+	}
+	memmove(&sbi->vip.inodes[pos + 1], &sbi->vip.inodes[pos],
+		(sbi->vip.count - pos) * sizeof(*sbi->vip.inodes));
+	sbi->vip.inodes[pos] = ino;
+	sbi->vip.count++;
+	spin_unlock_irqrestore(&sbi->vip.lock, flags);
+	return 0;
+}
+
+int f2fs_vip_remove(struct f2fs_sb_info *sbi, u32 ino)
+{
+	unsigned long flags;
+	int pos, ret = -ENOENT;
+
+	spin_lock_irqsave(&sbi->vip.lock, flags);
+	pos = __f2fs_vip_lower_bound(sbi, ino);
+	if (pos < sbi->vip.count && sbi->vip.inodes[pos] == ino) {
+		memmove(&sbi->vip.inodes[pos], &sbi->vip.inodes[pos + 1],
+			(sbi->vip.count - pos - 1) * sizeof(*sbi->vip.inodes));
+		sbi->vip.count--;
+		ret = 0;
+	}
+	spin_unlock_irqrestore(&sbi->vip.lock, flags);
+	return ret;
+}
+
+void f2fs_vip_destroy(struct f2fs_sb_info *sbi)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&sbi->vip.lock, flags);
+	kfree(sbi->vip.inodes);
+	sbi->vip.inodes = NULL;
+	sbi->vip.count = 0;
+	sbi->vip.capacity = 0;
+	sbi->vip.enabled = false;
+	spin_unlock_irqrestore(&sbi->vip.lock, flags);
+}
+#endif /* CONFIG_F2FS_VIP_FILE */
+
+#ifdef CONFIG_F2FS_FS_HYBRID_UFS
+/*
+ * The stock allocator needs a paired "ext" UFS LUN and a matching block-layer
+ * hybrid driver.  Neither interface exists in AOSP GKI, and guessing it could
+ * misdirect writes.  Report no capability so F2FS always uses the normal
+ * allocator and remains usable with ordinary single-device UFS layouts.
+ */
+bool f2fs_hw_support_hybrid(struct f2fs_sb_info *sbi)
+{
+	return false;
+}
+
+void f2fs_hw_hybrid_get_avail(struct f2fs_sb_info *sbi, u64 *main_avail,
+			      u64 *ext_avail)
+{
+	*main_avail = 0;
+	*ext_avail = 0;
+}
+
+void f2fs_disable_hybrid(struct f2fs_sb_info *sbi)
+{
+	sbi->hi.main.len = 0;
+	sbi->hi.ext.len = 0;
+}
+
+void f2fs_xiaomi_hybrid_init(struct f2fs_sb_info *sbi)
+{
+	memset(&sbi->hi, 0, sizeof(sbi->hi));
+	sbi->hi.free_ratio = 10;
+	sbi->hi.gc_threshold = 90;
+	sbi->hi.main_new_seg_ratio = 70;
+	sbi->hi.ext_new_seg_ratio = 30;
+}
+#endif /* CONFIG_F2FS_FS_HYBRID_UFS */
