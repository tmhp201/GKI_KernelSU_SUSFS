@@ -218,8 +222,20 @@ static inline void __update_iostat_latency(struct bio_iostat_ctx *iostat_ctx,
 	struct f2fs_sb_info *sbi = iostat_ctx->sbi;
 	struct iostat_lat_info *io_lat = sbi->iostat_io_lat;
 	unsigned long flags;
+	bool stock_enabled = sbi->iostat_enable;
+#ifdef CONFIG_XIAOMI_ENHANCED_IOSTAT
+	bool xiaomi_enabled = f2fs_xiaomi_iostat_enabled(sbi);
+#else
+	bool xiaomi_enabled = false;
+#endif
 
-	if (!sbi->iostat_enable)
+	/*
+	 * The stock MIUI init.rc enables only en_iostat_enable for F2FS:
