diff --git a/fs/f2fs/file.c b/fs/f2fs/file.c
index ce54bd8..3b4136f 100644
--- a/fs/f2fs/file.c
+++ b/fs/f2fs/file.c
@@ -597,6 +597,7 @@ static int finish_preallocate_blocks(struct inode *inode)
 
 static int f2fs_file_open(struct inode *inode, struct file *filp)
 {
+	struct f2fs_sb_info *sbi = F2FS_I_SB(inode);
 	int err = fscrypt_file_open(inode, filp);
 
 	if (err)
@@ -614,6 +615,28 @@ static int f2fs_file_open(struct inode *inode, struct file *filp)
 
 	trace_android_vh_f2fs_file_open(inode, filp);
 
+#ifdef CONFIG_F2FS_VIP_FILE
+	/*
+	 * Stock exposes the task-classification hooks to vendor modules.  If no
+	 * listener is present, use a conservative fallback: RT or negative-nice
+	 * tasks opening a regular file for write mark the inode as VIP.  A hook
+	 * listener can classify additional tasks via android_vh_f2fs_is_usr_task.
+	 */
+	if (READ_ONCE(sbi->vip.enabled) && S_ISREG(inode->i_mode) &&
+	    (filp->f_mode & FMODE_WRITE)) {
+		int is_hiprio = 0;
+		int is_usr = 0;
+
+		trace_android_vh_f2fs_is_hiprio_task(&is_hiprio);
+		trace_android_vh_f2fs_is_usr_task(&is_usr);
+		if (!is_hiprio && !is_usr)
+			is_hiprio = current->mm &&
+				(rt_task(current) || task_nice(current) < 0);
+		if (is_hiprio || is_usr)
+			f2fs_vip_insert(sbi, inode->i_ino);
+	}
+#endif
+
 	err = dquot_file_open(inode, filp);
 	if (err)
 		return err;
