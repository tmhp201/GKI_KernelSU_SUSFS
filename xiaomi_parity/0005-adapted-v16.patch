+	}
+	if (!strcmp(a->attr.name, "hybrid_free_ratio")) {
+		if (t > 100)
+			return -EINVAL;
+		sbi->hi.free_ratio = t;
+		return len;
+	}
+#endif
+	return -EOPNOTSUPP;
+}
