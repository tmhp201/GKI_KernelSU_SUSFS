+static ssize_t f2fs_xiaomi_attr_store(struct f2fs_attr *a,
+		struct f2fs_sb_info *sbi, const char *buf, size_t len)
+{
+	char config[80];
+	unsigned long t;
+	int ret;
+
+	ret = kstrtoul(skip_spaces(buf), 0, &t);
+	if (ret)
+		return ret;
+
+#ifdef CONFIG_XIAOMI_ENHANCED_IOSTAT
+	if (!strcmp(a->attr.name, "en_iostat_enable")) {
+		if (t > 1)
+			return -EINVAL;
+		f2fs_xiaomi_iostat_set_enabled(sbi, t);
+		return len;
+	}
+	if (!strcmp(a->attr.name, "iostat_window_period_s")) {
+		ret = snprintf(config, sizeof(config),
+			       "window_period_s=%lu", t);
+		if (ret < 0 || ret >= sizeof(config))
+			return -EINVAL;
+		ret = f2fs_xiaomi_iostat_store_config(sbi, config, ret);
+		return ret < 0 ? ret : len;
+	}
+	if (!strcmp(a->attr.name, "iostat_latency_threshold_ms")) {
+		ret = snprintf(config, sizeof(config),
+			       "latency_threshold_ms=%lu", t);
+		if (ret < 0 || ret >= sizeof(config))
+			return -EINVAL;
+		ret = f2fs_xiaomi_iostat_store_config(sbi, config, ret);
+		return ret < 0 ? ret : len;
+	}
+	if (!strcmp(a->attr.name, "iostat_window_latency") ||
+	    !strcmp(a->attr.name, "iostat_daily_latency")) {
+		if (t != 0)
+			return -EINVAL;
+		f2fs_xiaomi_iostat_reset(sbi);
+		return len;
+	}
+	if (!strcmp(a->attr.name, "iostat_config")) {
+		ret = f2fs_xiaomi_iostat_store_config(sbi, buf, len);
+		return ret;
+	}
+#endif
+	if (!strcmp(a->attr.name, "max_lock_elapsed_time")) {
+		sbi->max_lock_elapsed_time = t;
+		return len;
+	}
+	if (!strcmp(a->attr.name, "adjust_lock_priority")) {
+		if (t >= BIT(LOCK_NAME_MAX - 1))
+			return -EINVAL;
+		sbi->adjust_lock_priority = t;
+		return len;
+	}
+	if (!strcmp(a->attr.name, "lock_duration_priority")) {
+		if (t < NICE_TO_PRIO(MIN_NICE) || t > NICE_TO_PRIO(MAX_NICE))
+			return -EINVAL;
+		sbi->lock_duration_priority = t;
+		return len;
+	}
+	if (!strcmp(a->attr.name, "critical_task_priority")) {
+		if (t < NICE_TO_PRIO(MIN_NICE) || t > NICE_TO_PRIO(MAX_NICE))
+			return -EINVAL;
+		if (!capable(CAP_SYS_NICE))
+			return -EPERM;
+		sbi->critical_task_priority = t;
+		if (sbi->cprc_info.f2fs_issue_ckpt)
+			set_user_nice(sbi->cprc_info.f2fs_issue_ckpt,
+				      PRIO_TO_NICE(sbi->critical_task_priority));
+		if (sbi->gc_thread && sbi->gc_thread->f2fs_gc_task)
+			set_user_nice(sbi->gc_thread->f2fs_gc_task,
+				      PRIO_TO_NICE(sbi->critical_task_priority));
+		return len;
+	}
+#ifdef CONFIG_F2FS_VIP_FILE
+	if (!strcmp(a->attr.name, "vip_file_enable")) {
+		if (t > 1)
+			return -EINVAL;
+		if (!t)
+			f2fs_vip_destroy(sbi);
+		else
+			WRITE_ONCE(sbi->vip.enabled, true);
