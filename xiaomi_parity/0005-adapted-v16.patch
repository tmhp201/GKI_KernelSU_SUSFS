+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _F2FS_XIAOMI_H
+#define _F2FS_XIAOMI_H
+
+#include <linux/errno.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+
+struct f2fs_sb_info;
+
+void f2fs_xiaomi_init(struct f2fs_sb_info *sbi);
+void f2fs_xiaomi_destroy(struct f2fs_sb_info *sbi);
+
+#define F2FS_XIAOMI_IO_READ		0
+#define F2FS_XIAOMI_IO_WRITE_SYNC	1
+#define F2FS_XIAOMI_IO_WRITE_ASYNC	2
+#define F2FS_XIAOMI_IO_META		3
+#define F2FS_XIAOMI_IO_OTHER		4
+#define F2FS_XIAOMI_IO_BUCKETS		5
+
+struct f2fs_xiaomi_lat_stats {
+	u64 sum_ns;
+	u64 peak_ns;
+	u32 count;
+};
+
+struct f2fs_xiaomi_iostat {
+	spinlock_t lock;
+	bool enabled;
+	u64 window_period_ns;
+	u64 latency_threshold_ns;
+	u64 window_start_ns;
+	struct f2fs_xiaomi_lat_stats window[F2FS_XIAOMI_IO_BUCKETS];
+	struct f2fs_xiaomi_lat_stats last_window[F2FS_XIAOMI_IO_BUCKETS];
+	struct f2fs_xiaomi_lat_stats daily[F2FS_XIAOMI_IO_BUCKETS];
+	struct f2fs_xiaomi_lat_stats delayed[F2FS_XIAOMI_IO_BUCKETS];
+};
+
+struct f2fs_vip_manager {
+	u32 *inodes;
+	u32 count;
+	u32 capacity;
+	spinlock_t lock;
+	bool enabled;
+};
+
+struct f2fs_hybrid_die {
+	u32 start;
+	u32 start_segno;
+	u32 start_secno;
+	u32 len;
+	u32 free;
+	u32 free_segs;
+	u32 dirty_segs;
+	u32 gc_selected_count;
+	u32 gc_count;
+};
+
+struct f2fs_hybrid_info {
+	struct f2fs_hybrid_die main;
+	struct f2fs_hybrid_die ext;
+	u32 free_ratio;
+	u32 gc_threshold;
+	u64 large_file_threshold;
+	u32 main_new_seg_ratio;
+	u32 ext_new_seg_ratio;
+	u32 gc_alloc_mode;
+};
+
+#ifdef CONFIG_XIAOMI_ENHANCED_IOSTAT
+void f2fs_xiaomi_iostat_init(struct f2fs_sb_info *sbi);
+void f2fs_xiaomi_iostat_destroy(struct f2fs_sb_info *sbi);
+void f2fs_xiaomi_iostat_reset(struct f2fs_sb_info *sbi);
+void f2fs_xiaomi_iostat_record(struct f2fs_sb_info *sbi, unsigned int bucket,
+			       u64 latency_ns);
+bool f2fs_xiaomi_iostat_enabled(struct f2fs_sb_info *sbi);
+int f2fs_xiaomi_iostat_set_enabled(struct f2fs_sb_info *sbi, bool enabled);
+ssize_t f2fs_xiaomi_iostat_show_window(struct f2fs_sb_info *sbi, char *buf);
+ssize_t f2fs_xiaomi_iostat_show_daily(struct f2fs_sb_info *sbi, char *buf);
+ssize_t f2fs_xiaomi_iostat_show_config(struct f2fs_sb_info *sbi, char *buf);
+ssize_t f2fs_xiaomi_iostat_store_config(struct f2fs_sb_info *sbi,
+					const char *buf, size_t len);
+#else
+static inline void f2fs_xiaomi_iostat_init(struct f2fs_sb_info *sbi) {}
+static inline void f2fs_xiaomi_iostat_destroy(struct f2fs_sb_info *sbi) {}
+static inline void f2fs_xiaomi_iostat_reset(struct f2fs_sb_info *sbi) {}
+static inline void f2fs_xiaomi_iostat_record(struct f2fs_sb_info *sbi,
+		unsigned int bucket, u64 latency_ns) {}
+#endif
+
+#ifdef CONFIG_F2FS_VIP_FILE
+int f2fs_vip_bsearch(struct f2fs_sb_info *sbi, u32 ino);
+int f2fs_vip_insert(struct f2fs_sb_info *sbi, u32 ino);
+int f2fs_vip_remove(struct f2fs_sb_info *sbi, u32 ino);
+void f2fs_vip_destroy(struct f2fs_sb_info *sbi);
+#else
+static inline int f2fs_vip_bsearch(struct f2fs_sb_info *sbi, u32 ino)
+{
+	return -ENOENT;
+}
+static inline int f2fs_vip_insert(struct f2fs_sb_info *sbi, u32 ino)
+{
+	return 0;
+}
+static inline int f2fs_vip_remove(struct f2fs_sb_info *sbi, u32 ino)
+{
+	return 0;
+}
+static inline void f2fs_vip_destroy(struct f2fs_sb_info *sbi) {}
+#endif
+
+#ifdef CONFIG_F2FS_FS_HYBRID_UFS
+void f2fs_xiaomi_hybrid_init(struct f2fs_sb_info *sbi);
+bool f2fs_hw_support_hybrid(struct f2fs_sb_info *sbi);
+void f2fs_hw_hybrid_get_avail(struct f2fs_sb_info *sbi, u64 *main_avail,
+			      u64 *ext_avail);
+void f2fs_disable_hybrid(struct f2fs_sb_info *sbi);
+#else
+static inline void f2fs_xiaomi_hybrid_init(struct f2fs_sb_info *sbi) {}
+static inline bool f2fs_hw_support_hybrid(struct f2fs_sb_info *sbi)
+{
+	return false;
+}
+static inline void f2fs_hw_hybrid_get_avail(struct f2fs_sb_info *sbi,
+		u64 *main_avail, u64 *ext_avail)
+{
+	*main_avail = 0;
+	*ext_avail = 0;
+}
+static inline void f2fs_disable_hybrid(struct f2fs_sb_info *sbi) {}
+#endif
+
+#endif /* _F2FS_XIAOMI_H */
